+/*
+ * tb371fc: split a full-screen primary plane across the SSPP pair
+ *
+ * The vendor KMS stages a single full-width plane on one SSPP and lets the
+ * layer mixers source-split it. On this dual-DSI/DSC panel that only decodes
+ * the first slice row, the rest of the panel is garbled. The bootloader
+ * instead drives two half-width SSPPs (VIG0 at x=0 and VIG1 at x=half), one
+ * per layer mixer, which renders correctly.
+ *
+ * The vendor KMS does not expose standard atomic plane properties, so
+ * userspace cannot submit the second plane itself. Synthesize it here, before
+ * drm_atomic_helper_check() (and therefore before the encoder resource
+ * reservation), by duplicating the full-screen primary plane onto the paired
+ * SSPP. The primary is shrunk to the left half, the clone covers the right.
+ */
+static int tb371fc_split_wide_plane(struct drm_device *dev,
+		struct drm_atomic_state *state)
+{
+	static bool logged;
+	struct drm_crtc *crtc;
+	struct drm_crtc_state *crtc_state;
+	int i;
+
+	for_each_new_crtc_in_state(state, crtc, crtc_state, i) {
+		struct drm_plane_state *pstate, *sstate;
+		struct drm_plane *split = NULL, *p;
+		enum sde_sspp pipe;
+		uint32_t hdisplay, split_x;
+		uint64_t zpos;
+
+		if (!crtc_state->enable || !crtc_state->active)
+			continue;
+
+		pstate = drm_atomic_get_new_plane_state(state, crtc->primary);
+		if (!pstate || !pstate->fb)
+			continue;
+
+		hdisplay = crtc_state->mode.hdisplay;
+		if (hdisplay < 128 || (hdisplay & 1))
+			continue;
+
+		split_x = hdisplay / 2;
+
+		/*
+		 * Only a 1:1, full-screen primary (or one that this helper
+		 * already split in a previous commit) is handled.
+		 */
+		if (pstate->crtc_x != 0 || pstate->crtc_y != 0 ||
+				pstate->src_x != 0)
+			continue;
+		if (pstate->crtc_w != hdisplay && pstate->crtc_w != split_x)
+			continue;
+		if (pstate->src_w != (pstate->crtc_w << 16))
+			continue;
+
+		pipe = sde_plane_pipe(crtc->primary);
+		if (pipe != SSPP_VIG0 && pipe != SSPP_VIG2)
+			continue;
+
+		/* find the SSPP paired with the primary (VIG0->VIG1, ...) */
+		drm_for_each_plane(p, dev) {
+			if (p == crtc->primary || is_sde_plane_virtual(p))
+				continue;
+			if (sde_plane_pipe(p) != pipe + 1)
+				continue;
+			split = p;
+			break;
+		}
+		if (!split)
+			continue;
+
+		sstate = drm_atomic_get_existing_plane_state(state, split);
+		if (sstate && (sstate->crtc != crtc || sstate->fb))
+			continue;	/* pair already in use this commit */
+
+		if (!sstate) {
+			sstate = drm_atomic_get_plane_state(state, split);
+			if (IS_ERR(sstate))
+				return PTR_ERR(sstate);
+		}
+
+		/* primary covers the left mixer from now on */
+		if (pstate->crtc_w != split_x) {
+			pstate->crtc_w = split_x;
+			pstate->src_w = split_x << 16;
+		}
+
+		/* clone the right half onto the paired SSPP */
+		drm_atomic_set_fb_for_plane(sstate, pstate->fb);
+		sstate->crtc_x = split_x;
+		sstate->crtc_y = pstate->crtc_y;
+		sstate->crtc_w = hdisplay - split_x;
+		sstate->crtc_h = pstate->crtc_h;
+		sstate->src_x = split_x << 16;
+		sstate->src_y = pstate->src_y;
+		sstate->src_w = (hdisplay - split_x) << 16;
+		sstate->src_h = pstate->src_h;
+
+		if (drm_atomic_set_crtc_for_plane(sstate, crtc))
+			return -EINVAL;
+
+		/* keep the halves in separate blend stages (no source split) */
+		zpos = sde_plane_get_property(to_sde_plane_state(pstate),
+				PLANE_PROP_ZPOS);
+		if (zpos >= SDE_STAGE_MAX - SDE_STAGE_0 - 1)
+			zpos = 0;
+		sde_plane_set_zpos(split, sstate, zpos + 1);
+
+		if (!logged) {
+			logged = true;
+			pr_info("tb371fc: split plane%d %ux%u into %u + %u\n",
+					crtc->base.id, hdisplay,
+					pstate->crtc_h, split_x,
+					hdisplay - split_x);
+		}
+	}
+
+	return 0;
+}
