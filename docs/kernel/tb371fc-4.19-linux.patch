--- a/techpack/display/pll/Makefile
+++ b/techpack/display/pll/Makefile
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
-ccflags-y := -I$(srctree)/drivers/clk/qcom/
