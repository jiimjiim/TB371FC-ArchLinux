+/*
+ * TB371FC: late userspace is far too slow to reach a systemd unit before the
+ * 30 s deferred-probe deadline, and audio child devices are only created once
+ * ADSP is up.  Kick the ADSP from a delayed work after rootfs and /lib/firmware
+ * are available, but well before that deadline.
+ */
+static void adsp_loader_auto_boot(struct work_struct *work)
+{
+	if (adsp_private)
+		adsp_load_fw(NULL);
+}
+
+static DECLARE_DELAYED_WORK(adsp_boot_work, adsp_loader_auto_boot);
+
+static int __init adsp_loader_auto_boot_init(void)
+{
+	schedule_delayed_work(&adsp_boot_work, msecs_to_jiffies(8000));
+	return 0;
+}
+late_initcall_sync(adsp_loader_auto_boot_init);
