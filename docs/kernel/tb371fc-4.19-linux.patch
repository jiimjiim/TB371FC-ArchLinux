diff --git a/techpack/display/msm/tb371fc_earlydump.c b/techpack/display/msm/tb371fc_earlydump.c
new file mode 100755
index 000000000..de2b16bcd
--- /dev/null
+++ b/techpack/display/msm/tb371fc_earlydump.c
@@ -0,0 +1,255 @@
+// SPDX-License-Identifier: GPL-2.0
+/* TB371FC early read-only register capture.
+ *
+ * Runs at early_initcall, i.e. before the mdss/sde platform driver probes and
+ * before the DSI panel is re-initialised by Linux.  At that moment the
+ * bootloader (ABL) continuous-splash pipeline is still live, so this dump is
+ * the ground truth of a *working* DSI/DSC/MDP configuration for this panel.
+ * Compare it against the post-modeset dump taken later by the regpeek module.
+ */
+#include <linux/module.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+
+#define SDE_PHYS   0x0ae00000UL
+#define DSI0_PHYS  0x0ae94000UL
+#define DSI1_PHYS  0x0ae96000UL
+#define PHY0_PHYS  0x0ae94400UL
+#define PHY1_PHYS  0x0ae96400UL
+
+static void dump_dsi(const char *n, unsigned long phys)
+{
+	void __iomem *b = ioremap(phys, 0x1000);
+	u32 v, c, st, fifo, vm, ah, av, tot, hsync, vsync, vpos;
+	u32 lane, lane_ctl, phyerr, tout, clk, clkst, comp, comp2;
+
+	if (!b) { pr_err("regpeek: ioremap %s failed\n", n); return; }
+	v = readl(b + 0x000); c = readl(b + 0x004);
+	st = readl(b + 0x008); fifo = readl(b + 0x00c);
+	vm = readl(b + 0x010); ah = readl(b + 0x024);
+	av = readl(b + 0x028); tot = readl(b + 0x02c);
+	hsync = readl(b + 0x030); vsync = readl(b + 0x034);
+	vpos = readl(b + 0x038); lane = readl(b + 0x0a8);
+	lane_ctl = readl(b + 0x0ac); phyerr = readl(b + 0x0b4);
+	tout = readl(b + 0x0c0); clk = readl(b + 0x11c);
+	clkst = readl(b + 0x120);
+	comp = readl(b + 0x2a0); comp2 = readl(b + 0x2a4);
+	pr_err("regpeek %s phys=%08lx ver=%08x ctrl=%08x stat=%08x fifo=%08x vm=%08x ah=%08x av=%08x tot=%08x hsync=%08x vsync=%08x vpos=%08x lane=%08x lanectl=%08x phyerr=%08x tout=%08x clk=%08x clkst=%08x COMP=%08x COMP2=%08x\n",
+	       n, phys, v, c, st, fifo, vm, ah, av, tot, hsync, vsync,
+	       vpos, lane, lane_ctl, phyerr, tout, clk, clkst, comp, comp2);
+	pr_err("regpeek %s misc 018=%08x 01c=%08x 020=%08x 03c=%08x 040=%08x 2a8=%08x 2ac=%08x\n",
+	       n, readl(b + 0x018), readl(b + 0x01c), readl(b + 0x020),
+	       readl(b + 0x03c), readl(b + 0x040), readl(b + 0x2a8),
+	       readl(b + 0x2ac));
+	iounmap(b);
+}
+
+static void dump_phy(const char *n, unsigned long phys)
+{
+	void __iomem *b = ioremap(phys, 0x400);
+	u32 r0, r4, r1c, r20, r24, r28, r2c, r30, r34, r38, r3c, r40;
+	if (!b) { pr_err("regpeek: ioremap %s failed\n", n); return; }
+	r0 = readl(b + 0x000); r4 = readl(b + 0x004);
+	r1c = readl(b + 0x01c); r20 = readl(b + 0x020);
+	r24 = readl(b + 0x024); r28 = readl(b + 0x028);
+	r2c = readl(b + 0x02c); r30 = readl(b + 0x030);
+	r34 = readl(b + 0x034); r38 = readl(b + 0x038);
+	r3c = readl(b + 0x03c); r40 = readl(b + 0x040);
+	pr_err("regpeek %s phys=%08lx rev=%08x glbl=%08x lane0=%08x lane1=%08x lane2=%08x lane3=%08x clk=%08x tm=%08x lpx=%08x hsx=%08x lock=%08x r38=%08x r3c=%08x r40=%08x\n",
+	       n, phys, r0, r4, r1c, r20, r24, r28, r2c, r30, r34, r38, r3c, r40);
+	iounmap(b);
+}
+
+static void dump_dsc(const char *n, unsigned long phys)
+{
+	void __iomem *b = ioremap(phys, 0x100);
+	u32 c, e, p, s, ch, dly, sr;
+	if (!b) { pr_err("regpeek: ioremap %s failed\n", n); return; }
+	c = readl(b + 0x000); e = readl(b + 0x004); p = readl(b + 0x008);
+	s = readl(b + 0x00c); ch = readl(b + 0x010); dly = readl(b + 0x014);
+	sr = readl(b + 0x038);
+	pr_err("regpeek %s phys=%08lx COMMON=%08x ENC=%08x PIC=%08x SLICE=%08x CHUNK=%08x DELAY=%08x RC=%08x\n",
+	       n, phys, c, e, p, s, ch, dly, sr);
+	iounmap(b);
+}
+
+static void dump_blk(const char *n, unsigned long phys, int nreg)
+{
+	void __iomem *b = ioremap(phys, 0x100);
+	int i;
+	if (!b) { pr_err("regpeek: ioremap %s failed\n", n); return; }
+	pr_err("regpeek %s phys=%08lx:", n, phys);
+	for (i = 0; i < nreg; i++)
+		pr_err(" r%02x=%08x", i * 4, readl(b + i * 4));
+	pr_err("\n");
+	iounmap(b);
+}
+
+static void dump_idx(const char *n, unsigned long phys, const int *offs, int cnt)
+{
+	void __iomem *b = ioremap(phys, 0x110);
+	int i;
+	if (!b) { pr_err("regpeek: ioremap %s failed\n", n); return; }
+	pr_err("regpeek %s phys=%08lx", n, phys);
+	for (i = 0; i < cnt; i++)
+		pr_err(" %02x=%08x", offs[i], readl(b + offs[i]));
+	pr_err("\n");
+	iounmap(b);
+}
+
+static void dump_pll(const char *n, unsigned long pll_phys,
+		     unsigned long phy_phys, unsigned long gdsc_phys)
+{
+	void __iomem *p = ioremap(pll_phys, 0x260);
+	void __iomem *h = ioremap(phy_phys, 0x800);
+	void __iomem *g = ioremap(gdsc_phys, 0x10);
+	void __iomem *d = ioremap(pll_phys - 0x700, 0x100);
+	u32 sysmux = 0, status = 0, outdiv = 0, lval = 0, calpha = 0;
+	u32 ctrl0 = 0, cfg0 = 0, cfg1 = 0, ctrl3 = 0, pllctrl = 0;
+	u32 spare4 = 0, gdscr = 0, rbias = 0;
+	u32 dcmode = 0, dctl = 0, ddec = 0, dfrac = 0, doutdiv = 0;
+	u32 fracm = 0, frach = 0;
+
+	if (p) {
+		sysmux = readl(p + 0x028);
+		outdiv = readl(p + 0x0A8);
+		status = readl(p + 0x1B0);
+		lval = readl(p + 0x0CC);
+		calpha = readl(p + 0x0D0);
+		fracm = readl(p + 0x0D4);
+		frach = readl(p + 0x0D8);
+	}
+	if (d) {
+		dcmode = readl(d + 0x030);
+		dctl = readl(d + 0x040);
+		doutdiv = readl(d + 0x0A8);
+		ddec = readl(d + 0x0CC);
+		dfrac = readl(d + 0x0D0);
+	}
+	if (h) {
+		cfg0 = readl(h + 0x010);
+		cfg1 = readl(h + 0x014);
+		ctrl0 = readl(h + 0x024);
+		ctrl3 = readl(h + 0x030);
+		pllctrl = readl(h + 0x03C);
+		spare4 = readl(h + 0x128);
+		rbias = readl(h + 0x034);
+	}
+	if (g)
+		gdscr = readl(g);
+	pr_err("regpeek %s pll=%08lx phy=%08lx SYSMUX=%08x OUTDIV=%08x STATUS=%08x DEC=%08x FRAC=%08x:%08x:%08x CFG0=%08x CFG1=%08x CTRL0=%08x CTRL3=%08x PLLCNTRL=%08x SPARE4=%08x RBIAS=%08x GDSCR(%08lx)=%08x DYN cmode=%08x ctl=%08x outdiv=%08x dec=%08x frac=%08x\n",
+	       n, pll_phys, phy_phys, sysmux, outdiv, status, lval, calpha,
+	       fracm, frach, cfg0, cfg1, ctrl0, ctrl3, pllctrl, spare4, rbias,
+	       gdsc_phys, gdscr, dcmode, dctl, doutdiv, ddec, dfrac);
+	if (p)
+		iounmap(p);
+	if (h)
+		iounmap(h);
+	if (g)
+		iounmap(g);
+	if (d)
+		iounmap(d);
+}
+
+static void dump_split(void)
+{
+	void __iomem *t = ioremap(SDE_PHYS + 0x1000, 0x400);
+	void __iomem *i1 = ioremap(SDE_PHYS + 0x6b800, 0x300);
+	void __iomem *i2 = ioremap(SDE_PHYS + 0x6c000, 0x300);
+	if (!t) { pr_err("regpeek: split ioremap failed\n"); return; }
+	pr_err("regpeek split SPLIT_EN=%08x UPPER=%08x LOWER=%08x SPARE=%08x\n",
+	       readl(t + 0x2f4), readl(t + 0x2f8), readl(t + 0x3f0),
+	       readl(t + 0x28));
+	iounmap(t);
+	if (i1) {
+		pr_err("regpeek intf1 mux=%08x cfg=%08x cfg2=%08x fcount_en=%08x\n",
+		       readl(i1 + 0x25c), readl(i1 + 0x4), readl(i1 + 0xb8),
+		       readl(i1 + 0xa8));
+		iounmap(i1);
+	}
+	if (i2) {
+		pr_err("regpeek intf2 mux=%08x cfg=%08x cfg2=%08x fcount_en=%08x\n",
+		       readl(i2 + 0x25c), readl(i2 + 0x4), readl(i2 + 0xb8),
+		       readl(i2 + 0xa8));
+		iounmap(i2);
+	}
+}
+
+static void dump_sspp(const char *n, unsigned long phys)
+{
+	void __iomem *b = ioremap(phys, 0x200);
+	if (!b) { pr_err("regpeek: ioremap %s failed\n", n); return; }
+	pr_err("regpeek %s SIZE=%08x SRCXY=%08x OUTSIZE=%08x OUTXY=%08x ADDR0=%08x STRIDE=%08x FMT=%08x OPMODE=%08x MULTI=%08x R1SIZE=%08x R1XY=%08x R1OUT=%08x R1FMT=%08x\n",
+	       n, readl(b + 0x00), readl(b + 0x08), readl(b + 0x0c),
+	       readl(b + 0x10), readl(b + 0x14), readl(b + 0x24),
+	       readl(b + 0x30), readl(b + 0x38), readl(b + 0x170),
+	       readl(b + 0x16c), readl(b + 0x168), readl(b + 0x160),
+	       readl(b + 0x174));
+	iounmap(b);
+}
+
+static const int intf_offs[] = {0x0, 0x4, 0x8, 0x3c, 0x40, 0x64, 0x68};
+static const int pp_offs[] = {0x0, 0x4, 0x8, 0xa0, 0xac, 0xc8};
+static const int lm_offs[] = {0x0, 0x4, 0x8};
+static const int ctl_offs[] = {0x0, 0x4, 0x8, 0x14, 0x18, 0x40, 0x44, 0x70, 0x74, 0x134};
+
+static int __init regpeek_early_init(void)
+{
+	static const char *iname[4] = {"intf0", "intf1", "intf2", "intf3"};
+	static const char *pname[6] = {"pp0", "pp1", "pp2", "pp3", "pp4", "pp5"};
+	static const char *lname[6] = {"lm0", "lm1", "lm2", "lm3", "lm4", "lm5"};
+	static const char *cname[6] = {"ctl0", "ctl1", "ctl2", "ctl3", "ctl4", "ctl5"};
+	int i;
+
+	pr_err("regpeek EARLY t=%llu jiffies=%lu\n",
+	       ktime_get_ns(), jiffies);
+
+	dump_dsi("dsi0", DSI0_PHYS);
+	dump_dsi("dsi1", DSI1_PHYS);
+	dump_phy("phy0", PHY0_PHYS);
+	dump_phy("phy1", PHY1_PHYS);
+	dump_dsc("dsc0", SDE_PHYS + 0x81000);
+	dump_dsc("dsc1", SDE_PHYS + 0x81400);
+	dump_dsc("dsc2", SDE_PHYS + 0x81800);
+	dump_dsc("dsc3", SDE_PHYS + 0x81c00);
+
+	dump_blk("mdp_top", SDE_PHYS, 16);
+	dump_blk("intf0", SDE_PHYS + 0x6b000, 16);
+	dump_blk("intf1", SDE_PHYS + 0x6b800, 16);
+	dump_blk("pp0", SDE_PHYS + 0x71000, 12);
+	dump_blk("pp1", SDE_PHYS + 0x71800, 12);
+
+	for (i = 0; i < 4; i++)
+		dump_idx(iname[i], SDE_PHYS + 0x6b000 + i * 0x800,
+			 intf_offs, 7);
+	for (i = 0; i < 6; i++)
+		dump_idx(pname[i], SDE_PHYS + 0x71000 + i * 0x800,
+			 pp_offs, 6);
+	for (i = 0; i < 6; i++)
+		dump_idx(lname[i], SDE_PHYS + 0x45000 + i * 0x1000,
+			 lm_offs, 3);
+	for (i = 0; i < 6; i++)
+		dump_idx(cname[i], SDE_PHYS + 0x2000 + i * 0x200,
+			 ctl_offs, 10);
+
+	dump_pll("dsi0pll", 0x0ae94900, PHY0_PHYS, 0x0af03000);
+	dump_pll("dsi1pll", 0x0ae96900, PHY1_PHYS, 0x0af03000);
+
+	dump_split();
+	dump_sspp("vig0", SDE_PHYS + 0x5000);
+	dump_sspp("vig1", SDE_PHYS + 0x7000);
+	dump_sspp("vig2", SDE_PHYS + 0x9000);
+	dump_sspp("vig3", SDE_PHYS + 0xb000);
+	dump_sspp("dma0", SDE_PHYS + 0x25000);
+	dump_sspp("dma1", SDE_PHYS + 0x27000);
+
+	pr_err("regpeek EARLY done\n");
+	return 0;
+}
+early_initcall(regpeek_early_init);
+
+MODULE_LICENSE("GPL");
