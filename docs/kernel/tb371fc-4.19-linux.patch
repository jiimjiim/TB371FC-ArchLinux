diff --git a/tb371fc/scripts/p199-touch-resume-always.py b/tb371fc/scripts/p199-touch-resume-always.py
new file mode 100755
index 000000000..4caa5e85f
--- /dev/null
+++ b/tb371fc/scripts/p199-touch-resume-always.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""p199 - always run the full touch resume on panel unblank.
+
+The NVT driver short-circuits DRM_PANEL_EVENT_BLANK/UNBLANK when
+bTouchIsAwake is already 1 ("Touch is already resume"). After a display
+blank/unblank cycle that did not deliver a matching POWERDOWN (DPMS /
+composer restart paths) the touch IC can be powered off while the flag
+stays 1, so every later unblank skips the reset + firmware download and
+the controller never generates IRQs again (observed IRQ 68 counter stuck
+at 13 while the panel was on).
+
+Always run the resume sequence on unblank.  It costs one firmware
+download (~200 ms) per screen-on, which is what stock does on resume.
+"""
+P = "/opt/kernel-tb371fc/drivers/input/touchscreen/nt36532/nt36xxx.c"
+NL = chr(10)
+T = chr(9)
+CONT = "       "  # 7 spaces used by the stock line continuation
+
+OLD = (
+    T + T + "if (bTouchIsAwake) {" + NL +
+    T + T + T + "pr_err(\"[%s] %s %d: Touch is already resume\\n\"," + NL +
+    T + T + T + CONT + "\"NVT-ts\", \"nvt_ts_resume\", 3183);" + NL +
+    T + T + T + "kb_hid_resume();" + NL +
+    T + T + T + "return NOTIFY_OK;" + NL +
+    T + T + "}" + NL
+)
+NEW = (
+    T + T + "/*" + NL +
+    T + T + " * TB371FC: do not trust bTouchIsAwake here. A blank/unblank" + NL +
+    T + T + " * cycle without a matching POWERDOWN (DPMS, compositor restart)" + NL +
+    T + T + " * can leave the touch IC off while the flag is still 1; the old" + NL +
+    T + T + " * short-circuit then skipped the reset and the controller never" + NL +
+    T + T + " * generated IRQs again. Always re-init on unblank (stock does a" + NL +
+    T + T + " * firmware download on every resume as well)." + NL +
+    T + T + " */" + NL +
+    T + T + "if (bTouchIsAwake)" + NL +
+    T + T + T + "pr_err(\"[%s] %s %d: awake flag set, re-initialising anyway\\n\"," + NL +
+    T + T + T + CONT + "\"NVT-ts\", \"nvt_ts_resume\", 3183);" + NL
+)
+
+src = open(P).read()
+if "awake flag set, re-initialising anyway" in src:
+    raise SystemExit("already patched")
+assert src.count(OLD) == 1, "unblank short-circuit anchor x%d" % src.count(OLD)
+open(P + ".orig", "w").write(src)
+open(P, "w").write(src.replace(OLD, NEW))
+print("patched", P)
diff --git a/tb371fc/scripts/p220-dsc-mode-clock-consistent.py b/tb371fc/scripts/p220-dsc-mode-clock-consistent.py
new file mode 100755
index 000000000..2943d5cfa
--- /dev/null
+++ b/tb371fc/scripts/p220-dsc-mode-clock-consistent.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""p220 - make the DRM mode clock consistent with htotal/vtotal/refresh.
+
+TB371FC's panel is dual-DSI + DSC. dsi_convert_to_drm_mode() used to put the
+DSC-aware per-link pixel clock (375888 kHz) into drm_mode->clock while
+htotal/vtotal are full-frame values. Userspace derives the refresh rate from
+clock/(htotal*vtotal), so KWin reported 52.54/56.70/26.27 Hz although the
+panel really runs at 120/144/60 Hz (144.1 Hz measured via WAIT_VBLANK).
+
+Now the DRM clock is computed from the timings, and convert_to_dsi_mode()
+maps the DRM mode back onto the cached panel mode (same h/v/refresh) to keep
+the DSC-aware pixel clock used by mode matching and bit clock lookup.
+dsi_drm_find_bit_clk_rate() no longer requires the DRM clock to equal the
+cached pixel clock (it never will again for DSC modes).
+"""
+P = "/opt/kernel-tb371fc/techpack/display/msm/dsi/dsi_drm.c"
+NL = chr(10)
+T = chr(9)
+
+src = open(P).read()
+if "TB371FC: the DRM mode clock is derived from htotal" in src:
+    raise SystemExit("already patched")
+
+# ---- 1) signature ----
+OLD_SIG = (
+    "static void convert_to_dsi_mode(const struct drm_display_mode *drm_mode," + NL +
+    T + T + T + T + "struct dsi_display_mode *dsi_mode)"
+)
+NEW_SIG = (
+    "static void convert_to_dsi_mode(struct dsi_display *display," + NL +
+    T + T + T + T + "const struct drm_display_mode *drm_mode," + NL +
+    T + T + T + T + "struct dsi_display_mode *dsi_mode)"
+)
+assert src.count(OLD_SIG) == 1, "signature anchor x%d" % src.count(OLD_SIG)
+src = src.replace(OLD_SIG, NEW_SIG, 1)
+
+# ---- 2) body: canonical pixel clock ----
+OLD_BODY = (
+    T + "dsi_mode->timing.refresh_rate = drm_mode->vrefresh;" + NL +
+    NL +
+    T + "dsi_mode->pixel_clk_khz = drm_mode->clock;" + NL +
+    NL +
+    T + "dsi_mode->priv_info =" + NL +
+    T + T + "(struct dsi_display_mode_priv_info *)drm_mode->private;" + NL +
+    NL +
+    T + "if (dsi_mode->priv_info) {" + NL +
+    T + T + "dsi_mode->timing.dsc_enabled = dsi_mode->priv_info->dsc_enabled;" + NL +
+    T + T + "dsi_mode->timing.dsc = &dsi_mode->priv_info->dsc;" + NL +
+    T + "}"
+)
+NEW_BODY = (
+    T + "dsi_mode->timing.refresh_rate = drm_mode->vrefresh;" + NL +
+    NL +
+    T + "dsi_mode->priv_info =" + NL +
+    T + T + "(struct dsi_display_mode_priv_info *)drm_mode->private;" + NL +
+    NL +
+    T + "if (dsi_mode->priv_info) {" + NL +
+    T + T + "dsi_mode->timing.dsc_enabled = dsi_mode->priv_info->dsc_enabled;" + NL +
+    T + T + "dsi_mode->timing.dsc = &dsi_mode->priv_info->dsc;" + NL +
+    T + "}" + NL +
+    NL +
+    T + "/*" + NL +
+    T + " * TB371FC: the DRM mode clock is derived from htotal/vtotal/refresh" + NL +
+    T + " * (see dsi_convert_to_drm_mode), while the cached panel modes keep" + NL +
+    T + " * the DSC-aware pixel clock. Map the DRM mode back onto the cached" + NL +
+    T + " * entry so mode matching and bit clock lookup keep working." + NL +
+    T + " */" + NL +
+    T + "dsi_mode->pixel_clk_khz = drm_mode->clock;" + NL +
+    T + "if (display && display->modes) {" + NL +
+    T + T + "u32 i, count = 0;" + NL +
+    NL +
+    T + T + "dsi_display_get_mode_count(display, &count);" + NL +
+    T + T + "for (i = 0; i < count; i++) {" + NL +
+    T + T + T + "struct dsi_display_mode *m = &display->modes[i];" + NL +
+    NL +
+    T + T + T + "if (m->timing.v_active == dsi_mode->timing.v_active &&" + NL +
+    T + T + T + T + "m->timing.h_active == dsi_mode->timing.h_active &&" + NL +
+    T + T + T + T + "m->timing.refresh_rate ==" + NL +
+    T + T + T + T + T + "dsi_mode->timing.refresh_rate) {" + NL +
+    T + T + T + T + "dsi_mode->pixel_clk_khz = m->pixel_clk_khz;" + NL +
+    T + T + T + T + "break;" + NL +
+    T + T + T + "}" + NL +
+    T + T + "}" + NL +
+    T + "}"
+)
+assert src.count(OLD_BODY) == 1, "body anchor x%d" % src.count(OLD_BODY)
+src = src.replace(OLD_BODY, NEW_BODY, 1)
+
+# ---- 3) call sites ----
+OLD_CALL1 = T + "convert_to_dsi_mode(adjusted_mode, &(c_bridge->dsi_mode));"
+NEW_CALL1 = T + "convert_to_dsi_mode(c_bridge->display, adjusted_mode," + NL + \
+            T + T + T + T + "&(c_bridge->dsi_mode));"
+assert src.count(OLD_CALL1) == 1, "call1 x%d" % src.count(OLD_CALL1)
+src = src.replace(OLD_CALL1, NEW_CALL1, 1)
+
+n = src.count("convert_to_dsi_mode(mode, &dsi_mode);")
+assert n == 2, "mode calls x%d" % n
+src = src.replace("convert_to_dsi_mode(mode, &dsi_mode);",
+                  "convert_to_dsi_mode(display, mode, &dsi_mode);")
+
+OLD_CALL2 = T + T + "convert_to_dsi_mode(cur_mode, &cur_dsi_mode);"
+NEW_CALL2 = T + T + "convert_to_dsi_mode(display, cur_mode, &cur_dsi_mode);"
+assert src.count(OLD_CALL2) == 1, "cur call x%d" % src.count(OLD_CALL2)
+src = src.replace(OLD_CALL2, NEW_CALL2, 1)
+
+n = src.count("convert_to_dsi_mode(drm_mode, &dsi_mode);")
+assert n == 2, "drm calls x%d" % n
+src = src.replace("convert_to_dsi_mode(drm_mode, &dsi_mode);",
+                  "convert_to_dsi_mode(display, drm_mode, &dsi_mode);")
+
+# ---- 4) DRM clock from timings ----
+OLD_CLK = (
+    T + "drm_mode->vrefresh = dsi_mode->timing.refresh_rate;" + NL +
+    T + "drm_mode->clock = dsi_mode->pixel_clk_khz;"
+)
+NEW_CLK = (
+    T + "drm_mode->vrefresh = dsi_mode->timing.refresh_rate;" + NL +
+    T + "/*" + NL +
+    T + " * TB371FC: report a clock consistent with htotal/vtotal/refresh." + NL +
+    T + " * The DSC-aware pixel clock is not a full-frame clock, so" + NL +
+    T + " * userspace derived 52/57 Hz (120/144 Hz timing) and 26 Hz" + NL +
+    T + " * (60 Hz timing) from it. sde only uses mode->clock for line" + NL +
+    T + " * time estimates, the DSI timing itself stays unchanged." + NL +
+    T + " */" + NL +
+    T + "drm_mode->clock = div_u64((u64)drm_mode->htotal * drm_mode->vtotal *" + NL +
+    T + T + T + "dsi_mode->timing.refresh_rate, 1000);"
+)
+assert src.count(OLD_CLK) == 1, "clock anchor x%d" % src.count(OLD_CLK)
+src = src.replace(OLD_CLK, NEW_CLK, 1)
+
+# ---- 5) bit clock lookup must not compare clock ----
+OLD_LOOKUP = (
+    T + T + "if ((dsi_mode->timing.v_active == drm_mode->vdisplay) &&" + NL +
+    T + T + "    (dsi_mode->timing.h_active == drm_mode->hdisplay) &&" + NL +
+    T + T + "    (dsi_mode->pixel_clk_khz == drm_mode->clock) &&" + NL +
+    T + T + "    (dsi_mode->timing.refresh_rate == drm_mode->vrefresh)) {"
+)
+NEW_LOOKUP = (
+    T + T + "if ((dsi_mode->timing.v_active == drm_mode->vdisplay) &&" + NL +
+    T + T + "    (dsi_mode->timing.h_active == drm_mode->hdisplay) &&" + NL +
+    T + T + "    (dsi_mode->timing.refresh_rate == drm_mode->vrefresh)) {"
+)
+assert src.count(OLD_LOOKUP) == 1, "lookup anchor x%d" % src.count(OLD_LOOKUP)
+src = src.replace(OLD_LOOKUP, NEW_LOOKUP, 1)
+
+open(P + ".pre-p220", "w").write(open(P).read())
+open(P, "w").write(src)
+print("patched", P)
