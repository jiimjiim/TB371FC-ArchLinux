--- a/fs/file.c
+++ b/fs/file.c
@@ -636,6 +636,42 @@ out_unlock:
 	spin_unlock(&files->file_lock);
 	return -EBADF;
 }
+
+SYSCALL_DEFINE3(close_range, unsigned int, fd, unsigned int, max_fd,
+		unsigned int, flags)
+{
+	struct files_struct *files = current->files;
+	struct fdtable *fdt;
+	unsigned int i, max;
+
+	if (flags)
+		return -EINVAL;
+	if (fd > max_fd)
+		return -EINVAL;
+
+	spin_lock(&files->file_lock);
+	fdt = files_fdtable(files);
+	if (!fdt->max_fds) {
+		spin_unlock(&files->file_lock);
+		return 0;
+	}
+	max = min(max_fd, fdt->max_fds - 1);
+	spin_unlock(&files->file_lock);
+
+	if (fd > max)
+		return 0;
+
+	for (i = fd; ; i++) {
+		int ret = __close_fd(files, i);
+
+		if (ret < 0 && ret != -EBADF)
+			return ret;
+		if (i == max)
+			break;
+	}
+
+	return 0;
+}
 EXPORT_SYMBOL(__close_fd); /* for ksys_close() */
 
 void do_close_on_exec(struct files_struct *files)
