diff --git a/techpack/display/pll/dsi_pll_7nm.c b/techpack/display/pll/dsi_pll_7nm.c
index 9f49d65a1..fa48757de 100644
--- a/techpack/display/pll/dsi_pll_7nm.c
+++ b/techpack/display/pll/dsi_pll_7nm.c
@@ -994,6 +994,10 @@ static int vco_7nm_set_rate(struct clk_hw *hw, unsigned long rate,
 		return -EINVAL;
 	}
 
+	pr_err("TB371FC PLLSETRATE idx=%d rate=%lu pll_on=%d handoff=%d ctrl0=%08x\n",
+	       rsc->index, rate, rsc->pll_on, rsc->handoff_resources,
+	       MDSS_PLL_REG_R(rsc->phy_base, PHY_CMN_CTRL_0));
+
 	if (rsc->pll_on)
 		return 0;
 
@@ -1406,6 +1410,21 @@ static int dsi_pll_enable(struct dsi_pll_vco_clk *vco)
 		rsc->cached_cfg1 |= 0x3;
 		if (rsc->slave)
 			rsc->slave->cached_cfg1 |= 0x3;
+	} else {
+		/*
+		 * TB371FC bring-up: for DPHY the pixel clock has to come from
+		 * post_bit_div (bitclk/2).  If the cached mux value says
+		 * bitclk_src the DSI pixel timing engine runs at twice the
+		 * requested rate, overrunning the link FIFO.  The cache can go
+		 * stale across dsi_phy_enable()'s PLL/PHY reset, so force the
+		 * post_bit_div selection here.
+		 */
+		rsc->cached_cfg1 = (rsc->cached_cfg1 & ~0x1) | 0x1;
+		if (rsc->slave)
+			rsc->slave->cached_cfg1 =
+				(rsc->slave->cached_cfg1 & ~0x1) | 0x1;
+		pr_err("TB371FC PLLEN force pclk mux post_bit_div cfg1=%08x\n",
+		       rsc->cached_cfg1);
 	}
 
 	phy_reg_update_bits_sub(rsc, PHY_CMN_CLK_CFG1, 0x03, rsc->cached_cfg1);
@@ -1515,6 +1534,10 @@ static void vco_7nm_unprepare(struct clk_hw *hw)
 		return;
 	}
 
+	pr_err("TB371FC PLLUNPREP enter idx=%d handoff=%d status=%08x\n",
+	       pll->index, pll->handoff_resources,
+	       MDSS_PLL_REG_R(pll->pll_base, PLL_COMMON_STATUS_ONE));
+
 	/*
 	 * During unprepare in continuous splash use case we want driver
 	 * to pick all dividers instead of retaining bootloader configurations.
@@ -1568,8 +1591,28 @@ static int vco_7nm_prepare(struct clk_hw *hw)
 	}
 
 	/* Skip vco recalculation for continuous splash use case */
-	if (pll->handoff_resources)
-		return 0;
+	if (pll->handoff_resources) {
+		/*
+		 * TB371FC bring-up: dsi_phy_enable() fully re-initialises the
+		 * PHY (it asserts PHY_CMN_PLL_CNTRL reset), which stops a PLL
+		 * the bootloader left running.  Only honour the handoff
+		 * shortcut while the PLL is still locked, otherwise fall
+		 * through and start it for real.
+		 */
+		if (!dsi_pll_7nm_lock_status(pll)) {
+			pr_err("TB371FC PLLPREP handoff skip idx=%d\n",
+			       pll->index);
+			return 0;
+		}
+		pr_err("TB371FC PLLPREP handoff but PLL off, enabling idx=%d ctrl0=%08x\n",
+		       pll->index,
+		       MDSS_PLL_REG_R(pll->phy_base, PHY_CMN_CTRL_0));
+		pll->handoff_resources = false;
+	}
+
+	pr_err("TB371FC PLLPREP enter idx=%d cached=%lu rate=%lu ctrl0=%08x\n",
+	       pll->index, pll->vco_cached_rate, clk_hw_get_rate(hw),
+	       MDSS_PLL_REG_R(pll->phy_base, PHY_CMN_CTRL_0));
 
 	rc = mdss_pll_resource_enable(pll, true);
 	if (rc) {
@@ -1606,6 +1649,11 @@ static int vco_7nm_prepare(struct clk_hw *hw)
 		return rc;
 	}
 
+	pr_err("TB371FC PLLPREP ok idx=%d status=%08x ctrl0=%08x\n",
+	       pll->index,
+	       MDSS_PLL_REG_R(pll->pll_base, PLL_COMMON_STATUS_ONE),
+	       MDSS_PLL_REG_R(pll->phy_base, PHY_CMN_CTRL_0));
+
 	return rc;
 }
 
