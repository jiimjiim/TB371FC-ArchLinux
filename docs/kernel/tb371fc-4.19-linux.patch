+/*
+ * QCA6390 shares the combo chip rails with WCNSS. Power-up order follows the
+ * vendor bluetooth-power driver: regulators first, then reset_n low/high with
+ * 50 ms settling delays. Power is owned here (CONFIG_MSM_BT_POWER is off), so
+ * no other driver fights over the reset/sw_ctrl GPIOs.
+ */
+static int qca6390_power_on(struct hci_uart *hu)
+{
+	struct qca_serdev *qcadev = serdev_device_get_drvdata(hu->serdev);
+	int ret;
+
+	ret = qca_power_setup(hu, true);
+	if (ret) {
+		BT_ERR("QCA6390 regulator power on failed: %d", ret);
+		return ret;
+	}
+
+	if (qcadev->bt_en) {
+		gpiod_set_value_cansleep(qcadev->bt_en, 0);
+		msleep(50);
+		gpiod_set_value_cansleep(qcadev->bt_en, 1);
+		msleep(50);
+	}
+
+	if (qcadev->sw_ctrl)
+		dev_info(&hu->serdev->dev, "SW_CTRL is %d",
+			 gpiod_get_value_cansleep(qcadev->sw_ctrl));
+	return 0;
+}
+
+static void qca6390_power_off(struct hci_uart *hu)
+{
+	struct qca_serdev *qcadev = serdev_device_get_drvdata(hu->serdev);
+
+	if (qcadev->bt_en) {
+		gpiod_set_value_cansleep(qcadev->bt_en, 0);
+		msleep(100);
+	}
+
+	qca_power_setup(hu, false);
+}
