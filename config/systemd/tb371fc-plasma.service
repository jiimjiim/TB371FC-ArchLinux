[Unit]
Description=TB371FC KDE Plasma (software rendering) on tty7
After=systemd-logind.service systemd-user-sessions.service
Wants=systemd-logind.service systemd-user-sessions.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=alarm
PAMName=login
WorkingDirectory=/home/alarm
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty7
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=KDE
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=7
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=QT_QUICK_BACKEND=software
Environment=LANG=zh_CN.UTF-8
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/local/bin/tb371fc-plasma.sh
TimeoutStopSec=15s
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
