#!/usr/bin/env python3
import glob
import os
import struct
import sys
import time

BL = "/sys/class/backlight/panel0-backlight/brightness"
STATE = "/run/tb-powerkeyd.saved"
FMT = "llHHi"
SZ = struct.calcsize(FMT)
KEY_POWER = 116


def read_brightness():
    with open(BL) as f:
        return int(f.read().strip())


def write_brightness(value):
    with open(BL, "w") as f:
        f.write(str(value))


def find_device():
    if len(sys.argv) > 1:
        return sys.argv[1]
    for path in glob.glob("/dev/input/by-path/platform-c440000.qcom_spmi*power-on*event"):
        return path
    return "/dev/input/event0"


def main():
    fd = os.open(find_device(), os.O_RDONLY)
    last = 0.0
    while True:
        data = os.read(fd, SZ)
        if len(data) < SZ:
            continue
        _sec, _usec, etype, code, value = struct.unpack(FMT, data)
        if etype != 1 or code != KEY_POWER or value != 1:
            continue
        now = time.monotonic()
        if now - last < 1.0:
            continue
        last = now
        current = read_brightness()
        if current > 0:
            with open(STATE, "w") as f:
                f.write(str(current))
            write_brightness(0)
        else:
            saved = 1200
            try:
                with open(STATE) as f:
                    saved = int(f.read().strip())
            except (OSError, ValueError):
                pass
            write_brightness(saved)


if __name__ == "__main__":
    main()
